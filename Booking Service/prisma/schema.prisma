generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bookings {
  id            Int             @id @default(autoincrement())
  booking_group Int             @unique @default(autoincrement())
  user_id       Int
  schedule_id   Int
  status        String          @default("LOCKED") @db.VarChar(100)
  verification  String          @default("PENDING") @db.VarChar(100)
  payment_id    Int?
  expires_at    DateTime        @default(dbgenerated("(now() + '00:04:00'::interval)")) @db.Timestamptz(6)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  seat_bookings seat_bookings[]
}

model seat_bookings {
  id            Int      @id @default(autoincrement())
  booking_group Int
  schedule_id   Int
  seat_id       Int
  bookings      bookings @relation(fields: [booking_group], references: [booking_group], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_group")

  @@unique([schedule_id, seat_id], map: "unique_seat_per_schedule")
}
