generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bookings {
  id            Int             @id @default(autoincrement())
  booking_group Int             @unique @default(autoincrement())
  user_id       Int
  schedule_id   Int
  status        String          @default("LOCKED") @db.VarChar(100)
  payment_id    Int?
  expires_at    DateTime        @default(dbgenerated("(now() + '00:04:00'::interval)")) @db.Timestamptz(6)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  amount        Int?
  seat_bookings seat_bookings[]
}

model seat_bookings {
  id            Int      @id @default(autoincrement())
  booking_group Int
  schedule_id   Int
  seat_id       Int
  bookings      bookings @relation(fields: [booking_group], references: [booking_group], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_group")

  @@unique([schedule_id, seat_id], map: "unique_seat_per_schedule")
}

model faulty_payment {
  id            Int  @id @default(autoincrement())
  schedule_id   Int?
  user_id       Int?
  payment_id    Int?
  booking_group Int?
}

model schedules {
  id             Int       @unique
  scheduled_date DateTime  @db.Date
  departure_time DateTime? @db.Timestamptz(6)
  arrival_time   DateTime? @db.Timestamptz(6)
  status         String?   @db.VarChar(50)
  created_at     DateTime? @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  seat_ids       Int[]
  fare           Int
}
